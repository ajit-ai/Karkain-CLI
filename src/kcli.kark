// Karkain-CLI - command-line application construction helpers.
// Compatible with Karkain Language v1.2.0 (verified tag v1.2.0,
// commit 77d70693e1e3134dac312a303bffafa7d50fa988).
//
// Scope boundary: the Karkain CLI toolchain itself is part of the language
// distribution. This module does not reimplement it and does not modify
// compiler flags. It supplies small, portable building blocks for the
// argument surface of a Karkain command-line program: token classification,
// command and option extraction, positional access, command lookup and
// usage formatting.
//
// Canonical v1.2.0 subset: untyped params, no type annotations, no structs,
// no imports inside this module, arrays, strings, while/if, len/str/println.

// process_args returns the real process argument vector. In a binary built
// with `karkain build`, index 0 is the executable path. Under `karkain run`
// the toolchain does not forward extra arguments, so callers can also pass
// their own array to every other function in this module.
public func process_args() {
    return getArgs()
}

// is_option reports whether a token looks like an option (starts with '-').
public func is_option(token) {
    if len(token) > 0 {
        if token[0] == "-" {
            return true
        }
    }
    return false
}

// command returns the command token, i.e. the first argument after the
// program name. Returns "" when no command was supplied.
public func command(args) {
    if len(args) > 1 {
        return args[1]
    }
    return ""
}

// has_flag reports whether the exact flag token is present.
public func has_flag(args, flag) {
    let i = 1
    while (i < len(args)) {
        if args[i] == flag {
            return true
        }
        i = i + 1
    }
    return false
}

// option_value returns the token following `name`, or "" when `name` is
// absent or has no following token.
public func option_value(args, name) {
    let i = 1
    while (i < len(args)) {
        if args[i] == name {
            if i + 1 < len(args) {
                return args[i + 1]
            }
        }
        i = i + 1
    }
    return ""
}

// positional_count counts non-option arguments after the program name.
public func positional_count(args) {
    let n = 0
    let i = 1
    while (i < len(args)) {
        if is_option(args[i]) == false {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// positional returns the nth non-option argument after the program name.
// Returns "" when the index is out of range.
public func positional(args, n) {
    let found = 0
    let i = 1
    while (i < len(args)) {
        if is_option(args[i]) == false {
            if found == n {
                return args[i]
            }
            found = found + 1
        }
        i = i + 1
    }
    return ""
}

// command_index returns the index of cmd in a command list, or -1 when the
// command is unknown. Callers use the index to select their own handler.
public func command_index(commands, cmd) {
    let i = 0
    while (i < len(commands)) {
        if commands[i] == cmd {
            return i
        }
        i = i + 1
    }
    return -1
}

// usage builds a single-line usage string from a program name and a list of
// command names.
public func usage(program, commands) {
    let out = "Usage: " + program + " <command> [options] | commands:"
    let i = 0
    while (i < len(commands)) {
        out = out + " " + commands[i]
        i = i + 1
    }
    return out
}

// describe_command builds a one-line description for help output.
public func describe_command(name, description) {
    return name + " - " + description
}

// ---------------------------------------------------------------------------
// Phase 2 additions. Phase 1 signatures and behaviour are unchanged.

// new_registry creates a command registry of [path, description] pairs.
public func new_registry() {
    return []
}

// register_command adds or replaces a command path with a description.
// A subcommand path uses dotted form, e.g. "users.list".
public func register_command(registry, path, description) {
    let out = unregister_command(registry, path)
    out = push(out, path)
    out = push(out, description)
    return out
}

// unregister_command removes a command path.
public func unregister_command(registry, path) {
    let out = []
    let i = 0
    while (i < len(registry)) {
        if registry[i] == path {
            i = i + 2
        } else {
            out = push(out, registry[i])
            out = push(out, registry[i + 1])
            i = i + 2
        }
    }
    return out
}

// command_description returns the description for a path or "".
public func command_description(registry, path) {
    let i = 0
    while (i < len(registry)) {
        if registry[i] == path {
            return registry[i + 1]
        }
        i = i + 2
    }
    return ""
}

// has_command reports whether a path is registered.
public func has_command(registry, path) {
    return command_description(registry, path) != ""
}

// command_count returns the number of registered paths.
public func command_count(registry) {
    return len(registry) / 2
}

// help_text builds a deterministic multi-command help string using "|"
// separators because newline escapes are not part of the verified subset.
public func help_text(registry) {
    let out = "Commands:"
    let i = 0
    while (i < len(registry)) {
        out = out + "|" + describe_command(registry[i], registry[i + 1])
        i = i + 2
    }
    return out
}

// completions returns registered paths starting with a prefix.
public func completions(registry, prefix) {
    let out = []
    let i = 0
    while (i < len(registry)) {
        let p = registry[i]
        let n = len(prefix)
        let matches = true
        let j = 0
        while (j < n) {
            if j >= len(p) {
                matches = false
            } else {
                if p[j] != prefix[j] {
                    matches = false
                }
            }
            j = j + 1
        }
        if matches {
            out = push(out, p)
        }
        i = i + 2
    }
    return out
}

// missing_required counts required flag tokens that are absent.
public func missing_required(args, required) {
    let n = 0
    let i = 0
    while (i < len(required)) {
        if has_flag(args, required[i]) == false {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// new_profiles creates an empty configuration profile store.
public func new_profiles() {
    return []
}

// set_profile adds or replaces a named key/value pair in a profile.
public func set_profile(profiles, profile, key, value) {
    let out = []
    out = push(out, profile)
    out = push(out, key)
    out = push(out, value)
    let i = 0
    while (i < len(profiles)) {
        if profiles[i] == profile {
            if profiles[i + 1] == key {
                i = i + 3
            } else {
                out = push(out, profiles[i])
                out = push(out, profiles[i + 1])
                out = push(out, profiles[i + 2])
                i = i + 3
            }
        } else {
            out = push(out, profiles[i])
            out = push(out, profiles[i + 1])
            out = push(out, profiles[i + 2])
            i = i + 3
        }
    }
    return out
}

// profile_get returns a configured value or a fallback.
public func profile_get(profiles, profile, key, fallback) {
    let i = 0
    while (i < len(profiles)) {
        if profiles[i] == profile {
            if profiles[i + 1] == key {
                return profiles[i + 2]
            }
        }
        i = i + 3
    }
    return fallback
}

// new_hooks returns an empty command-hook chain.
public func new_hooks() {
    return []
}

// add_hook appends a named hook.
public func add_hook(hooks, name) {
    return push(hooks, name)
}

// run_hooks builds the ordered hook pipeline for a command path.
public func run_hooks(hooks, path) {
    let out = ""
    let i = 0
    while (i < len(hooks)) {
        out = out + hooks[i] + ">"
        i = i + 1
    }
    return out + path
}

// format_table builds a simple pipe-delimited two-column table.
public func format_table(headers, rows) {
    return headers[0] + "|" + headers[1] + "|" + rows[0] + "|" + rows[1]
}
